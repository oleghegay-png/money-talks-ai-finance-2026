# PRISM tracing (Block Convey). Leave the project id and key empty to switch tracing off.
PRISMTRACE_HOST=https://prism.blockconvey.com
PRISMTRACE_PROJECT_ID=
PRISMTRACE_API_KEY=

# Nicrron (OpenAI-compatible) - used by tools/nicrron_agent.py
NICRRON_BASE_URL=https://api.nicrron.ai/v1
NICRRON_MODEL=openai/gpt-6.1-sol
NICRRON_API_KEY=
